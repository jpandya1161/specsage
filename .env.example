# Copy to .env and adjust. Every value has a working default for local use.

# --- LLM provider: "ollama" (default, no key needed) or "anthropic" ---
SPECSAGE_LLM_PROVIDER=ollama
SPECSAGE_OLLAMA_BASE_URL=http://localhost:11434
SPECSAGE_OLLAMA_MODEL=llama3.1:8b

# Only needed if SPECSAGE_LLM_PROVIDER=anthropic
# SPECSAGE_ANTHROPIC_API_KEY=sk-ant-...
# SPECSAGE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Retrieval ---
SPECSAGE_QDRANT_URL=http://localhost:6333
SPECSAGE_COLLECTION=rfc_chunks

# --- API ---
SPECSAGE_API_HOST=0.0.0.0
SPECSAGE_API_PORT=8000
